# Python / uv
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/

# Transient
install.log

# Data / cache / runs live on ~/brats (outside the repo). Never commit if copied in.
/data/
/raw/
/cache/
/runs/

# Derived knowledge base — re-derivable from immutable sources (§5 commit rule).
kb/corpus/
kb/index/

# Large model weights (retrain clean; never reuse the original's — guardrail #7)
*.pth
*.pt
*.ckpt
*.weights.h5
*.keras

# NOTE (deliberately NOT ignored): wiki/ is committed (§5); training logs
# (CSV + TensorBoard event files) are artifacts to commit (§9) — copy them into reports/.

# KB sources are re-derivable (logs via tr, PDFs from arXiv) — rebuild with scripts/build_kb.sh
kb/sources/

# regenerable from report.md via scripts/08_report_html.py (root copy only —
# the published copy under docs/ MUST be committed for GitHub Pages)
/report.html

# Type-checker / test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
node_modules/

# Third-party original research code — kept locally for the reproduction study,
# NOT redistributed (licensing). See README for what it was used for.
reference/

# Built note (regenerable via scripts/build_note.py); the PUBLISHED copy lives in docs/
note/brats_explainer.html
